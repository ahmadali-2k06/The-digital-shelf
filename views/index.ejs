<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="style.css" />
    <title>Mobile shop</title>
  </head>
  <body>
    <nav>
      <div class="nav">
        <div class="heading-nav">
          <h1>The digital shelf</h1>
        </div>
        <div class="search-field-nav">
          <input
            type="search"
            name="search"
            id="search"
            placeholder="Search Products..."
          />
        </div>
      </div>
    </nav>
    <main>
      <div class="main-grid">
        <div class="side-bar">
          <div class="side-bar-head">
            <span class="filters-text">Filters</span>
            <span class="reset-text">Reset</span>
          </div>
          <div class="company-box">
            <div class="company-head">
              <span class="company-text">Company</span>
            </div>
            <div class="select-company">
              <select name="company" id="company-select">
                <option value="">All Brands</option>
                <option value="One Plus">One Plus</option>
                <option value="Google">Google</option>
                <option value="Samsung">Samsung</option>
                <option value="Apple">Apple</option>
              </select>
            </div>
          </div>
          <div class="max-price-box">
            <div class="max-price-text">Max Price</div>
            <input
              type="range"
              name="priceBar"
              id="price-bar"
              min="35000"
              max="1000000"
              step="1000"
            />
            <div class="price">
              <span class="variable-price">PKR 340,000</span>
            </div>
          </div>
          <div class="sort-box">
            <span class="sort-text">Sort By Price</span>
            <div class="select-sort">
              <select
                name="sort"
                id="sort-select-price"
                data-sort-field="price"
              >
                <option value="relevance">Relevance</option>
                <option value="price">Price: Low to High</option>
                <option value="-price">Price: High to low</option>
              </select>
            </div>
            <span class="sort-text">Sort By Name</span>
            <div class="select-sort">
              <select name="sort" id="sort-select-name" data-sort-field="name">
                <option value="relevance">Relevance</option>
                <option value="name">Name: A to Z</option>
                <option value="-name">Name: Z to A</option>
              </select>
            </div>
          </div>
          <div class="featured-only-box">
            <span class="featured-text">Featured Only</span>
            <input type="checkbox" name="featured-check" id="featured-check" />
          </div>
        </div>
        <div class="products">
          <% if (message) { %>
          <div class="message">
            <h1><%= message %></h1>
            <a href="/">Back to Products</a>
          </div>
          <% } else { %> <% products.forEach(product => { %> <% if
          (product.featured === true) { %>
          <div class="product-card" data-featured="true">
            <div class="card-image">
              <img
                src="https://placehold.co/600x400/000000/ffffff?text=<%= product.name.replace(/ /g, '+') %>"
                alt="img"
              />
              <div class="featured-label">Featured</div>
            </div>
            <div class="card-content">
              <div class="company-name"><%= product.company %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="price-rating-wrapper">
                <div class="price-product">
                  PKR <%= product.price.toLocaleString() %>
                </div>
                <div class="rating-wrapper">
                  <div class="rating">
                    <svg
                      class="rating-svg"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        d="M9.049 2.927c.3-.921 1.603-.921 
                  1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 
                  1.371 1.24.588 1.81l-2.8 2.034a1 1 0 
                  00-.364 1.118l1.07 3.292c.3.921-.755 
                  1.688-1.54 1.118l-2.8-2.034a1 1 0 
                  00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 
                  1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 
                  1 0 00.951-.69l1.07-3.292z"
                      ></path>
                    </svg>
                    <div class="rating"><%= product.rating %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } else { %>
          <div class="product-card">
            <div class="card-image">
              <img
                src="https://placehold.co/600x400/000000/ffffff?text=<%= product.name.replace(/ /g, '+') %>"
                alt="img"
              />
            </div>
            <div class="card-content">
              <div class="company-name"><%= product.company %></div>
              <div class="product-name"><%= product.name %></div>
              <div class="price-rating-wrapper">
                <div class="price-product">
                  PKR <%= product.price.toLocaleString() %>
                </div>
                <div class="rating-wrapper">
                  <div class="rating">
                    <svg
                      class="rating-svg"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        d="M9.049 2.927c.3-.921 1.603-.921 
                  1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 
                  1.371 1.24.588 1.81l-2.8 2.034a1 1 0 
                  00-.364 1.118l1.07 3.292c.3.921-.755 
                  1.688-1.54 1.118l-2.8-2.034a1 1 0 
                  00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 
                  1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 
                  1 0 00.951-.69l1.07-3.292z"
                      ></path>
                    </svg>
                    <div class="rating"><%= product.rating %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <% } %> <% }) %> <% } %>
        </div>
      </div>
      <div class="pages-buttons-box">
        <a
          href="/?page=<%= currentPage - 1 %>"
          class="pages-buttons previous <%= currentPage === 1 ? 'disabled' : '' %>"
        >
          Previous
        </a>
        <a
          href="/?page=<%= currentPage + 1 %>"
          class="pages-buttons next <%= currentPage === totalPages ? 'disabled' : '' %>"
        >
          Next
        </a>
      </div>
    </main>
    <script src="script.js"></script>
  </body>
</html>
